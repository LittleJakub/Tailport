# ============================================================
#  Tailport configuration
#
#  Tailport is the Astrill-safe door to your Tailscale tailnet:
#  every service listed here becomes reachable on this machine
#  at http://localhost:<local_port> while the service is ON.
#  Not just LLMs - any tailnet service (SSH, Immich, Jupyter...).
#
#  Edit with Notepad, save, then Turn OFF / Turn ON to apply.
#  Values are key=value; '#' starts a comment; blank lines ignored.
# ============================================================

# --- Python -------------------------------------------------
# Full path to pythonw.exe (runs the forwarder invisibly).
# Leave empty to resolve pythonw from the system PATH.
pythonw=C:\Users\user\AppData\Local\Programs\Python\Python311\pythonw.exe

# --- WSL2 ---------------------------------------------------
# The Linux distro that runs tailscaled on this machine.
wsl_distro=Ubuntu

# --- tailnet door (usually leave as-is) ---------------------
# SOCKS5 proxy exposed by tailscaled inside WSL2 (reachable from Windows).
socks_host=127.0.0.1
socks_port=1055

# --- LLM forwarder (the convenience door for local AI) ------
# Local port on THIS machine -> a tailnet LLM server (llama.cpp, vLLM...).
# This is also the service the tray icon's health check probes.
llm_local_port=8080
llm_target=100.101.102.103:8080

# --- extra port forwards: ANY tailnet service ---------------
# format: forward.N = local_port:tailnet_ip:tailnet_port
# Each line opens http://localhost:<local_port> on this machine,
# tunneled through the tailnet door to the target service.
# Examples: Immich photos (2283), Paperless docs (8001), SSH (22), ...
forward.1=2283:100.101.102.103:2283
forward.2=8001:100.101.102.103:8001
